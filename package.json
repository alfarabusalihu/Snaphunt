{
  "name": "snaphunt",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "run-p start:backend start:mcp",
    "start:backend": "npm run start --prefix apps/backend",
    "start:mcp": "npm run start --prefix apps/mcp-server",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  }
}
