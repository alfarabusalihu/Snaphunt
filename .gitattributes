# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.css text
*.html text

# Shell scripts should always have LF
*.sh text eol=lf

# Windows batch files should always have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
