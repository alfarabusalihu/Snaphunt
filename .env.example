# ── Server Ports ──────────────────────────────────────────────────────────────
PORT=3400
MCP_PORT=3300

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Required: MongoDB connection string for user authentication and starred CVs
# Get free cluster at: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/snaphunt?retryWrites=true&w=majority

# ── Qdrant Vector Database ────────────────────────────────────────────────────
# Optional: If not provided, will use local Qdrant at http://localhost:6333
# Cloud option: Get free cluster at https://cloud.qdrant.io
# Local option: Run `docker run -p 6333:6333 qdrant/qdrant`
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Frontend API URL ───────────────────────────────────────────────────────────
# For local development, use http://localhost:3400
# For production, set to your deployed backend URL
VITE_API_URL=http://localhost:3400
